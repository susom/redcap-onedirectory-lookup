{
    "name": "Microsoft Graph API Lookup (Previously OneDirectory)",
    "namespace": "Stanford\\RedcapOneDirectoryLookup",
    "description": "A REDCap module that looks up user information from Microsoft Graph API and populates REDCap project fields based on configured mappings. OneDirectory Elastic search is decommissioned and replaced by Microsoft Graph API.",
    "documentation": "README.md",
    "framework-version": 16,
    "authors": [
        {
            "name": "Ihab Zeedia",
            "email": "ihab.zeedia@stanford.edu",
            "institution": "Stanford University"
        },
        {
            "name": "Jordan Schultz",
            "email": "jmschult@stanford.edu",
            "institution": "Stanford University"
        }
    ],
    "enable-every-page-hooks-on-system-pages": false,
    "links": {
        "project": [
        ],
        "control-center": [
        ]
    },
    "no-auth-pages": [
        "ajax/get_users",
        "ajax/get_user_photo",
        "ajax/get_user_manager"
    ],
    "enable-no-auth-logging": true,
    "project-settings": [
        {
            "key": "instance",
            "name": "<b>Search Instance</b>",
            "required": true,
            "type": "sub_settings",
            "repeatable": true,
            "sub_settings": [
                {
                    "key": "alert-if-exist",
                    "name": "<b>Alert user if data already saved before update<br>",
                    "required": true,
                    "type": "checkbox"
                },
                {
                    "key": "search-field",
                    "name": "<b>Field used to lookup users<br>",
                    "required": true,
                    "type": "field-list"
                },
                {
                    "key": "enforce-affiliation",
                    "name": "<b>Enforce Affiliation?</b>",
                    "required": false,
                    "type": "dropdown",
                    "choices": [
                        {
                            "name": "Yes",
                            "value": "yes"
                        },
                        {
                            "name": "No",
                            "value": "no"
                        }
                    ]
                },
                {
                    "key": "affiliation-enforcement-source",
                    "name": "<b>Affiliation Enforcement Source</b>",
                    "required": true,
                    "type": "dropdown",
                    "choices": [
                        {
                            "name": "Stanford Affiliations",
                            "value": "em"
                        },
                        {
                            "name": "Survey fields",
                            "value": "survey"
                        }
                    ],
                    "branchingLogic": {
                        "field": "enforce-affiliation",
                        "value": "yes"
                    }
                },
                {
                    "key": "affiliation-em-value",
                    "name": "<b>Affiliation EM Value</b>",
                    "required": true,
                    "type": "dropdown",
                    "choices": [
                        {
                            "name": "Stanford Children''s Health",
                            "value": "1"
                        },
                        {
                            "name": "Stanford Health Care",
                            "value": "2"
                        },
                        {
                            "name": "Stanford University",
                            "value": "3"
                        }
                    ],
                    "branchingLogic": { "field": "affiliation-enforcement-source", "value": "em" }
                },
                {
                    "key": "affiliation-survey-field",
                    "name": "<b>Affiliation Survey Field</b><div class='alert alert-danger mt-2'><b>The survey field value (text, checkbox, or radio) must match one of the following exactly to allow user lookup:</b><ul><li>1, Stanford Children's Health</li><li>2, Stanford Health Care</li><li>3, Stanford University</li></ul><b>Otherwise, you will get empty results.</b></div>",
                    "required": true,
                    "type": "field-list",
                    "branchingLogic": { "field": "affiliation-enforcement-source", "value": "survey" }
                },
                {
                    "key": "attribute_instance",
                    "name": "<b>Attribute Instance Map</b>",
                    "required": true,
                    "type": "sub_settings",
                    "repeatable": true,
                    "sub_settings": [
                        {
                            "key": "one-directory-attribute",
                            "name": "<b>Select OneDirectory Attribute</b>",
                            "required": false,
                            "type": "dropdown",
                            "choices": [
                                {
                                    "name": "OneDirectoryId (Deprecated backward compatibility)",
                                    "value": "OneDirectoryId"
                                },
                                {
                                    "name": "affiliate (Deprecated backward compatibility)",
                                    "value": "affiliate"
                                },
                                {
                                    "name": "jobId (Deprecated backward compatibility)",
                                    "value": "jobId"
                                },
                                {
                                    "name": "first_name (Deprecated backward compatibility)",
                                    "value": "first_name"
                                },
                                {
                                    "name": "last_name (Deprecated backward compatibility)",
                                    "value": "last_name"
                                },
                                {
                                    "name": "fullname (Deprecated backward compatibility)",
                                    "value": "fullname"
                                },
                                {
                                    "name": "phone (Deprecated backward compatibility)",
                                    "value": "phone"
                                },
                                {
                                    "name": "phone2 (Deprecated backward compatibility)",
                                    "value": "phone2"
                                },
                                {
                                    "name": "email (Deprecated backward compatibility)",
                                    "value": "email"
                                },
                                {
                                    "name": "title (Deprecated backward compatibility)",
                                    "value": "title"
                                },
                                {
                                    "name": "SUNet of SID (Deprecated backward compatibility)",
                                    "value": "suid"
                                },
                                {
                                    "name": "id",
                                    "value": "id"
                                },
                                {
                                    "name": "displayName",
                                    "value": "displayName"
                                },
                                {
                                    "name": "givenName",
                                    "value": "givenName"
                                },
                                {
                                    "name": "surname",
                                    "value": "surname"
                                },
                                {
                                    "name": "mail",
                                    "value": "mail"
                                },
                                {
                                    "name": "userPrincipalName",
                                    "value": "userPrincipalName"
                                },
                                {
                                    "name": "accountEnabled",
                                    "value": "accountEnabled"
                                },
                                {
                                    "name": "jobTitle",
                                    "value": "jobTitle"
                                },
                                {
                                    "name": "department",
                                    "value": "department"
                                },
                                {
                                    "name": "companyName",
                                    "value": "companyName"
                                },
                                {
                                    "name": "officeLocation",
                                    "value": "officeLocation"
                                },
                                {
                                    "name": "businessPhones",
                                    "value": "businessPhones"
                                },
                                {
                                    "name": "mobilePhone",
                                    "value": "mobilePhone"
                                },
                                {
                                    "name": "preferredLanguage",
                                    "value": "preferredLanguage"
                                },
                                {
                                    "name": "identities",
                                    "value": "identities"
                                },
                                {
                                    "name": "otherMails",
                                    "value": "otherMails"
                                },
                                {
                                    "name": "mailNickname",
                                    "value": "mailNickname"
                                },
                                {
                                    "name": "usageLocation",
                                    "value": "usageLocation"
                                },
                                {
                                    "name": "createdDateTime",
                                    "value": "createdDateTime"
                                },
                                {
                                    "name": "assignedLicenses",
                                    "value": "assignedLicenses"
                                },
                                {
                                    "name": "assignedPlans",
                                    "value": "assignedPlans"
                                },
                                {
                                    "name": "onPremisesExtensionAttributes",
                                    "value": "onPremisesExtensionAttributes"
                                },
                                {
                                    "name": "streetAddress",
                                    "value": "streetAddress"
                                },
                                {
                                    "name": "city",
                                    "value": "city"
                                },
                                {
                                    "name": "state",
                                    "value": "state"
                                },
                                {
                                    "name": "postalCode",
                                    "value": "postalCode"
                                },
                                {
                                    "name": "country",
                                    "value": "country"
                                },
                                {
                                    "name": "physicalDeliveryOfficeName",
                                    "value": "physicalDeliveryOfficeName"
                                },
                                {
                                    "name": "telephoneNumber",
                                    "value": "telephoneNumber"
                                },
                                {
                                    "name": "userType",
                                    "value": "userType"
                                },
                                {
                                    "name": "showInAddressList",
                                    "value": "showInAddressList"
                                },
                                {
                                    "name": "Manager ID",
                                    "value": "manager.id"
                                },
                                {
                                    "name": "Manager Display Name",
                                    "value": "manager.displayName"
                                },
                                {
                                    "name": "Manager Mail",
                                    "value": "manager.mail"
                                },
                                {
                                    "name": "Manager User Principal Name",
                                    "value": "manager.userPrincipalName"
                                }
                            ]
                        },
                        {
                            "key": "mapped-field",
                            "name": "<b>Select Project field where to save the OneDirectory Attribute<br>",
                            "required": true,
                            "type": "field-list"
                        }
                    ]
                }
            ]
        },
        {
            "key": "enable-project-debug-logging",
            "name": "<b>Enable Debug Logging</b><br><i>(optional)</i> Requires installation and configuration of emLogger",
            "required": false,
            "type": "checkbox"
        }
    ],
    "system-settings": [
        {
            "key": "onedirectory-url",
            "name": "<b>URL to Onedirectory server:</b>",
            "required": true,
            "type": "text"
        },
        {
            "key": "survey-lookup-rate-limit",
            "name": "<b>Survey lookup rate limit (per minute, per authenticated user):</b><br><i>(optional, default 30)</i> Applies only to unauthenticated survey lookups that pass webauth. Leave blank to use the default.",
            "required": false,
            "type": "text"
        },
        {
            "key": "google-cloud-project-id",
            "name": "<b>Google Project Id:</b> This will store MS Graph API credentials in Secret Manager. (e.g., my-gcp-project). Make sure you create the following SECRET in Secrets:<ol><li>MS_GRAPH_CLIENT_ID</li><li>MS_GRAPH_CLIENT_SECRET</li><li>MS_GRAPH_TENANT_ID</li></ol> ",
            "required": true,
            "type": "text"
        },
        {
            "key": "microsoft-graph-access-token",
            "name": "<b>Microsoft Graph Access token:</b>",
            "required": false,
            "type": "text"
        },
        {
            "key": "microsoft-graph-access-token-expiration-timestamp",
            "name": "<b>Microsoft Graph Access token expiration timestamp:</b>",
            "required": false,
            "type": "text"
        },
        {
            "key": "google-cloud-service-account-key",
            "name": "<b>Google Service Account JSON:</b>",
            "required": false,
            "type": "textarea"
        },
        {
            "key": "enable-system-debug-logging",
            "name": "<b>Enable Debug Logging (system-wide)</b><i>(optional)</i> Requires installation and configuration of emLogger",
            "required": false,
            "type": "checkbox"
        }
    ],
    "compatibility": {
        "php-version-min": "",
        "php-version-max": "",
        "redcap-version-min": "",
        "redcap-version-max": ""
    }
}
